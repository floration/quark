# Race map: run, jump, and rocket-jump along the course.
title Sprint
for race
sun -0.3 1.0 0.5

# start platform
box -6 -1 -6 6 0 6
spawn race -3 0 3 0
spawn race 0 0 3 0
spawn race 3 0 3 0
spawn race -3 0 0 0
spawn race 3 0 0 0
spawn any 0 0 0 0

# course heads toward -z
box -3 -1 -14 3 0 -6
box -3 -1 -20 3 0.5 -16
box -3 -1 -26 3 1 -22
accent -3 -1 -34 3 1.5 -28
checkpoint -3 1.5 -34 3 4.5 -28
box -10 -1 -40 -4 2 -34
box -16 -1 -46 -10 2.5 -40
box -16 -1 -60 -10 2.5 -48
box -16 2.5 -54 -10 3.5 -53
accent -16 -1 -70 -4 3 -62
checkpoint -16 3 -70 -4 6 -62
box -2 -1 -70 6 4 -62
box 8 -1 -70 14 5 -62
box 8 5 -64 14 6 -63
box 8 -1 -86 14 6 -72
accent 4 -1 -96 18 6.5 -88
checkpoint 4 6.5 -96 18 10 -88
