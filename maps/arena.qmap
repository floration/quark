# quark map format (one entry per line, '#' comments, units = meters, Y is up)
#   box    x0 y0 z0 x1 y1 z1     solid block (base material)
#   accent x0 y0 z0 x1 y1 z1     solid block (accent material)
#   spawn  a|b|any|race x y z [yaw_degrees]
#   site   x0 y0 z0 x1 y1 z1     bomb site
#   hill   x0 y0 z0 x1 y1 z1     king of the hill zone
#   checkpoint x0 y0 z0 x1 y1 z1 race checkpoints in order (last = finish)
#   path   x y z                 payload waypoints in order
#   sun    dx dy dz              direction toward the sun
title Arena
sun 0.45 1.0 0.3

# floor and outer walls
box -34 -1 -34 34 0 34
box -34 0 -34 -32 8 34
box 32 0 -34 34 8 34
box -32 0 -34 32 8 -32
box -32 0 32 32 8 34

# center hill platform with ramps
accent -5 0 -5 5 1 5
box -5 0 5 5 0.5 7
box -5 0 -7 5 0.5 -5
box -7 0 -5 -5 0.5 5
box 5 0 -5 7 0.5 5
box -1 1 -1 1 3.5 1

# mid lane walls
box -20 0 -2 -12 3 2
box 12 0 -2 20 3 2
box -2 0 12 2 3 20
box -2 0 -20 2 3 -12

# cover crates
box -14 0 10 -11 1.5 13
box 11 0 10 14 1.5 13
box -14 0 -13 -11 1.5 -10
box 11 0 -13 14 1.5 -10
box -26 0 -4 -23 2 4
box 23 0 -4 26 2 4
box -8 0 22 -5 1.2 25
box 5 0 -25 8 1.2 -22

# raised side walkways
box -32 0 -24 -27 2.5 -14
box 27 0 14 32 2.5 24
box -27 0 -24 -26 1.25 -14
box 26 0 14 27 1.25 24

# bomb site markers (low accent pads)
accent -24 -0.05 -28 -16 0 -20
accent 16 -0.05 -28 24 0 -20

# spawns: team A south (+z), team B north (-z)
spawn a -6 0 28 0
spawn a 0 0 29 0
spawn a 6 0 28 0
spawn a -12 0 27 0
spawn a 12 0 27 0
spawn b -6 0 -28 180
spawn b 0 0 -29 180
spawn b 6 0 -28 180
spawn b -12 0 -27 180
spawn b 12 0 -27 180
spawn any -28 0 28 45
spawn any 28 0 28 -45
spawn any -28 0 -28 135
spawn any 28 0 -28 -135
spawn any -20 0 8 90
spawn any 20 0 -8 -90

site -24 0 -28 -16 3 -20
site 16 0 -28 24 3 -20
hill -5 1 -5 5 4 5

# payload goes from team A's side to team B's base
path 9 0 26
path 9 0 8
path 9 0 -8
path 9 0 -18
path 0 0 -27
