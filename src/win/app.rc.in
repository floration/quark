// Windows resources of @QUARK_RES_FILE@ (generated by CMakeLists.txt quark_win_resources from src/win/app.rc.in):
// the icon, the version information Explorer shows under Properties > Details, and the application manifest.
// An exe with neither looks like the anonymous binaries antivirus heuristics flag most often (docs/SIGNING.md).

GLFW_ICON ICON "@QUARK_RES_ICON@"

1 24 "@QUARK_RES_MANIFEST@"

1 VERSIONINFO
FILEVERSION @QV_MAJOR@,@QV_MINOR@,@QV_PATCH@,@QV_BUILD@
PRODUCTVERSION @QV_MAJOR@,@QV_MINOR@,@QV_PATCH@,@QV_BUILD@
FILEFLAGSMASK 0x3fL
FILEFLAGS @QV_FLAGS@
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "floration"
            VALUE "FileDescription", "@QUARK_RES_DESC@"
            VALUE "FileVersion", "@QUARK_VERSION@"
            VALUE "InternalName", "@QUARK_RES_NAME@"
            VALUE "LegalCopyright", "Copyright (C) floration"
            VALUE "OriginalFilename", "@QUARK_RES_FILE@"
            VALUE "ProductName", "quark"
            VALUE "ProductVersion", "@QUARK_VERSION@"
            VALUE "Comments", "https://quark.casa"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
