# maps/*.qmap are generated at build time by tools/make_maps.py (CMake). A hand-made map that should ship goes in
# maps/ too: un-ignore it here with a "!/maps/<name>.qmap" line (CMake reads these lines: only the generated maps
# and the ones un-ignored here are embedded and copied into the build).
/maps/*.qmap
/maps/*.qmap.bak
/maps/*.tmp
__pycache__/
# the map editor's own files when serve.py runs from the source folder (tools/map_editor/serve.py): Settings,
# who laid each map out, the decoration panel's saved presets, the page's three.js when copied in by hand
/tools/map_editor/config.json
/tools/map_editor/config.json.tmp
/tools/map_editor/provenance.json
/tools/map_editor/provenance.json.tmp*
/tools/map_editor/deco_presets/user/
/tools/map_editor/vendor/
