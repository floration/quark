# maps/*.qmap are generated at build time by tools/make_maps.py (CMake). A hand-made map that should ship goes in
# maps/ too: un-ignore it here with a "!/maps/<name>.qmap" line (CMake reads these lines: only the generated maps
# and the ones un-ignored here are embedded and copied into the build).
/maps/*.qmap
/maps/*.qmap.bak
/maps/*.tmp
/maps/legacy/
!/maps/cobblestone.qmap
!/maps/surfy.qmap
!/maps/accelerator.qmap
!/maps/amphitheatre.qmap
!/maps/museum.qmap
!/maps/reactors.qmap
!/maps/riverside.qmap
__pycache__/
