{"entries": [
  {"id": "project-manager", "name": "Supervisor Board (this app)", "sources": ["tools/project_manager"],
   "run": "builtin:self-update", "check": "project-manager\\server.py"},
  {"id": "docs", "name": "Claude Manager", "sources": ["tools/docs_manager"],
   "run": "py -3 tools\\docs_manager\\install.py", "check": "docs-manager\\index.html", "restartsPort": 8766},
  {"id": "github", "name": "GitHub Manager", "sources": ["tools/github_manager"],
   "run": "py -3 tools\\github_manager\\install.py --no-start", "check": "github-manager\\server.py", "restartsPort": 8767},
  {"id": "tests", "name": "Tests Editor", "sources": ["tools/tests_editor"],
   "run": "py -3 tools\\tests_editor\\install.py --quiet", "check": "tests-editor\\serve.py", "restartsPort": 8775},
  {"id": "dashboard", "name": "Editor Manager", "sources": ["tools/editor_dashboard"],
   "run": "py -3 tools\\editor_dashboard\\dashboard.py --install", "check": "editor-dashboard\\dashboard.py", "restartsPort": 8765},
  {"id": "model", "name": "Model Editor", "sources": ["tools/model_editor", "src/client", "tools/maps", "tests/assets_tests.cpp", "VERSION"],
   "run": "tools\\model_editor\\install.cmd \"%QUARK%\\model-editor\"", "check": "model-editor\\model-editor.html", "timeoutSec": 1800, "lowPriority": true},
  {"id": "sound", "name": "Sound Editor", "sources": ["tools/sound_editor", "VERSION", "assets/sfx", "assets/voice", "assets/overrides"],
   "run": "py -3 tools\\sound_editor\\install.py", "check": "sound-editor\\sound-editor.html", "timeoutSec": 1800, "lowPriority": true},
  {"id": "botmap", "name": "Bot + Map Editors", "sources": ["tools/bot_editor", "tools/map_editor", "tools/bots", "src", "tests", "tools/make_maps.py", "tools/maps", "CMakeLists.txt", "VERSION"],
   "run": "py -3 tools\\bot_editor\\install.py", "check": "bot-editor\\run.cmd", "restartsPort": [8769, 8770],
   "timeoutSec": 1800, "lowPriority": true},
  {"id": "physics", "name": "Physics Editor", "sources": ["tools/physics_editor", "tools/map_editor/native", "src", "CMakeLists.txt", "VERSION"],
   "run": "py -3 tools\\physics_editor\\serve.py --install", "check": "physics-editor\\serve.py", "restartsPort": 8772},
  {"id": "weapons", "name": "Weapons Editor", "sources": ["tools/weapon_editor", "tools/map_editor/native", "tools/bot_editor/native", "src", "CMakeLists.txt", "VERSION"],
   "run": "py -3 tools\\weapon_editor\\serve.py --install", "check": "weapons-editor\\serve.py", "restartsPort": 8773},
  {"id": "gamemode", "name": "Gamemode Editor", "sources": ["tools/mode_editor", "tools/modes"],
   "run": "py -3 tools\\mode_editor\\install.py \"%QUARK%\\gamemode-editor\"", "check": "gamemode-editor\\serve.py", "restartsPort": 8771},
  {"id": "hud", "name": "HUD Editor", "sources": ["tools/hud_editor"],
   "run": "py -3 tools\\hud_editor\\serve.py --install", "check": "hud-editor\\serve.py", "restartsPort": 8774},
  {"id": "ui", "name": "UI Editor", "sources": ["tools/ui_customizer", "assets/fonts"],
   "run": "py -3 tools\\ui_customizer\\install.py", "check": "ui-customizer\\ui-customizer.html"},
  {"id": "electron", "name": "Electron (the app window)", "run": "builtin:electron-update"}
]}
