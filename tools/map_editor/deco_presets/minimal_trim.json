{
  "name": "Minimal trim",
  "description": "Skirting, door and window frames and stair kick plates, all in trim (drawn, not solid): nothing to snag on, never changes a route.",
  "rules": [
    { "name": "Skirting", "gen": "edgeTrim", "target": { "kind": "filter", "filter": { "role": "wall" } },
      "params": { "edges": "bottom", "at": "cover", "height": 0.22, "depth": 0.04, "mat": 8 } },
    { "name": "Door and window frames", "gen": "windowFrames", "target": { "kind": "filter", "filter": { "role": "wall" } },
      "params": { "kinds": "both", "frame": 0.15, "depth": 0.05, "sill": true, "mat": 8 } },
    { "name": "Stair kick plates", "gen": "kickPlates", "target": { "kind": "all" },
      "params": { "height": 0.1, "depth": 0.02, "mat": 8, "nosing": true, "nosingWidth": 0.06, "nosingMat": 8 } }
  ]
}
