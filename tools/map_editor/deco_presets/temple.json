{
  "name": "Temple",
  "description": "Stone and lacquer: a deep skirting, a chair rail at 1.1 m, pilasters with a base and a capital every 6 m, framed doorways and windows with sills, an inlaid floor border along the walls.",
  "rules": [
    { "name": "Skirting", "gen": "edgeTrim", "target": { "kind": "filter", "filter": { "role": "wall" } },
      "params": { "edges": "bottom", "at": "cover", "height": 0.35, "depth": 0.06, "mat": 8 } },
    { "name": "Chair rail", "gen": "bands", "target": { "kind": "filter", "filter": { "role": "wall", "minHeight": 2.4 } },
      "params": { "heights": "1.1", "base": "floor", "height": 0.12, "depth": 0.05, "mat": 8 } },
    { "name": "Pilasters", "gen": "pillars", "target": { "kind": "filter", "filter": { "role": "wall", "minHeight": 3, "minLength": 6 } },
      "params": { "placement": "spacing", "size": 0.5, "depth": 0.15, "spacing": 6, "minHeight": 3, "base": true, "flare": 0.08, "mat": 8 } },
    { "name": "Frames", "gen": "windowFrames", "target": { "kind": "filter", "filter": { "role": "wall" } },
      "params": { "kinds": "both", "frame": 0.2, "depth": 0.06, "sill": true, "sillDepth": 0.18, "mat": 8 } },
    { "name": "Floor border", "gen": "floorBorder", "target": { "kind": "filter", "filter": { "role": "floor", "minLength": 4 } },
      "params": { "at": "walls", "width": 0.4, "sink": 0.04, "raise": 0.005, "mat": 8 } }
  ]
}
