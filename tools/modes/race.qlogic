logic 1
base race
# Race: the course's checkpoints in order; the first to finish takes the round, first to 3. Nobody hurts anybody
# (rocket jumps only move you). The warmup is practice: it never starts by itself.
use race

param rounds int = 3
param roundTime f32 = 0 # no clock: a round runs until someone finishes (owner, 2026-10-31)
param respawnTime f32 = 1

slot canAutoStart:
  return no

slot warmup:
  racePractice()

# Knockback only, and only on yourself, once the race is on.
slot canDamage:
  if phase == roundEnd or phase == matchEnd or phase == freeze: return no
  return phase == warmup

slot canHit:
  return phase == warmup or attacker == none or attacker == victim

slot tick:
  raceStep()
  if phaseEnd > 0 and now >= phaseEnd: endRound(none, "time")   # (only a clock a host or mod set)

slot finish:
  endRound(p)

slot roundOver:
  w = first(q in everyone where score[q] >= hud.roundsToWin)
  if w != none: endMatch(w, w, " wins the match")
