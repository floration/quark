logic 1
base koth
# King of the hill: a team alone on the hill scores a point a second; first to the target wins. Respawns.
param target int = 100 # points to win, when the host sets no score limit
param respawnTime f32 = 4

state match hold[team] f32 = 0 # seconds each team has held the hill

slot matchStart:
  hud.target = cfg.scoreLimit > 0 ? cfg.scoreLimit : target

slot tick:
  inA = 0
  inB = 0
  for p in playing where alive(p) and inZone(p, hill):
    objTime[p] = objTime[p] + dt
    if team(p) == A: inA = inA + 1
    else: inB = inB + 1
  if inA > 0 and inB > 0:
    hud.contested = yes
    hud.owner = none
  elif inA > 0 or inB > 0:
    t = inA > 0 ? A : B
    hud.contested = no
    hud.owner = t
    hold[t] = hold[t] + dt
  else:
    hud.contested = no
    hud.owner = none
  teamScore[A] = int(hold[A])
  teamScore[B] = int(hold[B])
  if teamScore[A] >= hud.target or teamScore[B] >= hud.target:
    w = teamScore[A] >= hud.target ? A : B
    endMatch(w, w, " wins the match")
