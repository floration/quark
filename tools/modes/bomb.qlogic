logic 1
base bomb
# Bomb: the attackers carry the bomb to a site and plant it; the defenders stop them or defuse it. One life a round,
# first to 7; the sides swap after 6 rounds.
use bomb

param rounds int = 7
param roundTime f32 = 105
param plantTime f32 = 3 # holding USE on a site, on the ground
param defuseTime f32 = 6 # holding USE by the bomb
param bombFuse f32 = 40 # from the plant to the blast
param bombRadius f32 = 18 # the blast kills everyone this close
param defuseRange f32 = 1.8
param pickupRange f32 = 1.2
param bombReturn f32 = 15 # a dropped bomb lies this long before it goes back to an attacker

# The first half's attack is team A; from round rounds (7) on it's team B.
slot roundSetup:
  half = hud.roundsToWin - 1
  attackers = half > 0 and roundNo > half ? B : A

slot roundStart:
  c = random(p in team(attackers) where alive(p))
  if c != none: giveBomb(c)

# A planter or defuser can't move.
slot frozen:
  return phase == freeze or (phase == live and bomb.acting == p)

slot tick:
  bombStep()
  def = other(attackers)
  if aliveCount(def) == 0: endRound(attackers, "defenders eliminated")
  if aliveCount(attackers) == 0 and bomb.state != planted: endRound(def, "attackers eliminated")
  if bomb.state == planted:
    hud.overtime = no # (the fuse is the clock now)
    return
  if any(p in team(attackers) where alive(p) and inZone(p, sites)): touchObjective()
  if now < phaseEnd: hud.overtime = no
  elif not holdOvertime(): endRound(def, "time")

slot plant:
  announce("bomb planted")

slot defuse:
  endRound(other(attackers), "bomb defused")

slot explode:
  endRound(attackers, "bomb exploded")

slot roundOver:
  firstToRounds()
