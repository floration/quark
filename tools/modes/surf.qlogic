logic 1
base surf
# Surf: race's rules on a course of steep ramps, with run-only movement (no dash, no grapple: you strafe). The
# checkpoints in order; the first to finish takes the round, first to 3. Nobody hurts anybody (rocket jumps only move
# you). The warmup is practice: it never starts by itself.
use race

param rounds int = 3
param roundTime f32 = 0 # no clock: a round runs until someone finishes (owner, 2026-10-31)
param respawnTime f32 = 1

slot canAutoStart:
  return no

slot warmup:
  racePractice()

# knife only, nobody hurts anybody, warmup too (owner, 2026-10-28)
slot canDamage:
  return no

slot canHit:
  return attacker == none or attacker == victim

slot tick:
  raceStep()
  if phaseEnd > 0 and now >= phaseEnd: endRound(none, "time") # (only a clock a host or mod set)

slot finish:
  endRound(p)

slot roundOver:
  w = first(q in everyone where score[q] >= hud.roundsToWin)
  if w != none: endMatch(w, w, " wins the match")
