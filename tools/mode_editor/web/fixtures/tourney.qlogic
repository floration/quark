logic 1
base tourney
# Tourney: a single-elimination bracket of 1v1 matches, one at a time (everyone else spectates); each match is first
# to 3 rounds. The bracket's champion wins.
use drain
use bracket

param rounds int = 3
param roundEndTime f32 = 2.5 # short rounds, a shorter break (common: 4)
param stalemate f32 = 30 # with no damage dealt before the drain starts
param drainRate f32 = 5 # health a second, everyone, in a stalemate

slot canAutoStart:
  return teamCount(A) >= 2

slot matchStart:
  if not tourneyBegin(): endMatch(none, "not enough players for a tourney")

slot tick:
  if tourneyWalkover(): return # a finalist left: the other went through
  a = aliveCount(A)
  b = aliveCount(B)
  if a == 0 or b == 0: endRound(a > 0 ? A : b > 0 ? B : none)
  stalemateDrain()

# A side has won the match: it goes through, and the next match is set up (or the tourney is over).
slot roundOver:
  n = hud.roundsToWin
  if teamScore[A] >= n or teamScore[B] >= n: tourneyAdvance(teamScore[A] >= n ? A : B)
