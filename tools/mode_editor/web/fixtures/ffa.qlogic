logic 1
base ffa
# Free for all: one round; the most frags when the clock (or the score limit) runs out wins. A tie goes to
# overtime: the next kill wins.
# (fixture: transcribed from the mode-editor design, section 3.2, until tools/modes/ffa.qlogic exists)

param respawn f32 = 2 # s dead before respawning
param matchTime f32 = 600 # s, when the host sets no time limit
param rankedTime f32 = 300 # s, ranked instagib

slot roundsToWin:
  return 1

slot roundLength:
  if ranked: return rankedTime
  return cfg.timeLimit > 0 ? f32(cfg.timeLimit) : matchTime

slot respawnDelay:
  return respawn

slot canAutoStart:
  return teamCount(A) >= 2

slot kill: # victim, killer, weapon
  if killer != none and killer != victim: score[killer] = score[killer] + 1
  elif phase == live:
    score[victim] = score[victim] - 1 # a suicide, a fall, the world
  if phase == live and hud.overtime and killer != none and killer != victim: finish()

slot tick:
  if cfg.scoreLimit > 0 and any(p in everyone where score[p] >= cfg.scoreLimit): finish()
  elif now >= phaseEnd: finish()

proc finish:
  top = best(p in playing by score[p])
  if top == none: endMatch(none, "match over")
  elif count(p in playing where score[p] == score[top]) == 1: endMatch(top, top, " wins the match")
  elif not hud.overtime:
    hud.overtime = yes
    announce("tie - overtime! next kill wins")
