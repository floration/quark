logic 1
base vs
# Team VS: one life a round, the last side standing takes it; first to 5 rounds. A stalemate drains everyone's health.
use drain

param rounds int = 5
param stalemate f32 = 30 # with no damage dealt before the drain starts
param drainRate f32 = 5 # health a second, everyone, in a stalemate

slot tick:
  a = aliveCount(A)
  b = aliveCount(B)
  if a == 0 or b == 0: endRound(a > 0 ? A : b > 0 ? B : none)
  stalemateDrain()

slot roundOver:
  firstToRounds()
