logic 1
base points
# Multi point: each team attacks once, taking the map's points in order against the clock (each point adds time).
# Scored like payload: more points taken wins, then the faster attack, then the one there sooner; dead level is a draw.
use points

param roundTime f32 = 150 # the attack's clock at the start
param respawnTime f32 = 5
param pointBonus f32 = 90 # added for every point taken
param captureTime f32 = 12 # one attacker alone (more go faster, up to twice)
param captureDecay f32 = 0.05 # capture a second a point loses when the attack leaves it

slot roundSetup:
  attackers = roundNo % 2 == 1 ? A : B

# The second attack is decided once the result is locked (TF2's stopwatch): past the first attack's mark wins, and
# against one that finished, a clock past its time loses. The round ends then, not minutes later at time out.
proc stopwatchLocked:
  if roundNo % 2 != 0: return
  done = other(attackers)
  if cart.completed[done] > 0:
    if now - roundStartTime > cart.completed[done]: endRoundNoScore(done)
  elif cart.best[attackers] > cart.best[done]: endRoundNoScore(attackers)
  elif cart.best[attackers] == cart.best[done] and cart.best[done] > 0 and cart.bestTime[attackers] < cart.bestTime[done]: endRoundNoScore(attackers)

slot tick:
  if pointStep(): return # a point was taken (or there's none left to attack)
  stopwatchLocked()
  if now < phaseEnd: hud.overtime = no
  elif not holdOvertime(): endRoundNoScore(other(attackers), "time")

slot capture:
  if i >= pointCount:
    cart.completed[attackers] = f32(now - roundStartTime)
    endRound(attackers, "every point taken")
  addTime(pointBonus)
  announce(attackers, " took point ", letter(i - 1), " - +", int(pointBonus), " s, on to point ", letter(i))
  log("point ", i, " taken by ", attackers)

slot roundOver:
  if roundNo < 2 or roundNo % 2 != 0: return
  w = none
  if teamScore[A] != teamScore[B]: w = teamScore[A] > teamScore[B] ? A : B
  elif teamScore[A] > 0:
    if cart.completed[A] != cart.completed[B]: w = cart.completed[A] < cart.completed[B] ? A : B
  elif cart.best[A] != cart.best[B]: w = cart.best[A] > cart.best[B] ? A : B
  elif cart.best[A] > 0 and cart.bestTime[A] != cart.bestTime[B]: w = cart.bestTime[A] < cart.bestTime[B] ? A : B # level: the sooner there
  if w == none: endMatch(none, "match draw")
  endMatch(w, w, " wins the match")
