+// ---- (ui-customizer extract, scratch only) every widget / label / panel as a JSON element in the renderer's draw log
+namespace {
+std::string jesc(const std::string& t) {
+    std::string o = "\"";
+    for (unsigned char c : t) {
+        if (c == '"' || c == '\\') { o += '\\'; o += (char)c; }
+        else if (c < 32) { char b[8]; snprintf(b, sizeof b, "\\u%04x", c); o += b; }
+        else o += (char)c;
+    }
+    return o + "\"";
+}
+std::string jnum(float v) { char b[32]; snprintf(b, sizeof b, "%.6g", std::isfinite(v) ? v : 0.0f); return b; }
+std::string jcol(const Color& c) { return "[" + jnum(c.r) + "," + jnum(c.g) + "," + jnum(c.b) + "," + jnum(c.a) + "]"; }
+std::string jexp(const UiExp& e, const char* key = "action") {
+    static const char* n[] = {"none", "nav", "cfg", "state", "cmd", "url", "quit", "edit", "local", "inert", "bind"};
+    std::string a = n[e.kind];
+    if (e.what) a += std::string(":") + e.what;
+    if (e.arg && e.kind == UiExp::STATE) a += std::string("=") + e.arg;
+    std::string o = std::string(",\"") + key + "\":" + jesc(a);
+    if (e.id) o += ",\"id\":" + jesc(e.id);
+    if (e.arg && e.kind != UiExp::STATE) o += ",\"typing\":" + jesc(e.arg);
+    if (e.flags & UiExp::OPTIONAL) o += ",\"dynamic\":true";
+    return o;
+}
+std::string jnames(const std::vector<std::string>& v) {
+    std::string o = "[";
+    for (size_t i = 0; i < v.size(); i++) o += (i ? "," : "") + jesc(v[i]);
+    return o + "]";
+}
+struct Depth { Renderer* r; Depth(Renderer* r) : r(r) { r->drawDepth++; } ~Depth() { r->drawDepth--; } };
+}
+std::string uiJsonEscape(const std::string& t) { return jesc(t); }
+void Ui::logEl(const char* kind, float x, float y, float w, float h, const std::string& rest) {
